PORT=4000

# Generate a real secret before running for real, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# The frontend's URL — used to build verification and share links
APP_URL=http://localhost:5173

# --- Database (Laragon's bundled MySQL defaults) ---
# Run schema.sql once in HeidiSQL/phpMyAdmin before starting the server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sleeve

# --- Outgoing mail (for the "verify your email" link) ---
# Leave these blank during local development: verification links will be
# printed to this server's console instead of emailed, so you can still
# test the flow without setting up SMTP. Fill these in with real SMTP
# credentials (e.g. from Mailtrap, SendGrid, or your own mail server) once
# you're ready for real emails to go out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sleeve <no-reply@sleeve.local>"
